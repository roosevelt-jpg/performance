# Public marketing site URL (canonical / Open Graph)
NEXT_PUBLIC_SITE_URL=https://marketing.theformulaperformance.com

# --- Section 8 placeholders (swap once confirmed) ---
# ASSUMED: Pro £297 / Elite £497 — used only inside Q9, never on public cards
NEXT_PUBLIC_PRICE_PRO=297
NEXT_PUBLIC_PRICE_ELITE=497

# ASSUMED: no entry tier below Challenge (tier row = 3 cards). Set true to show a 4th card via config.
NEXT_PUBLIC_SHOW_ENTRY_TIER=false

# ASSUMED: GoHighLevel native calendar. Switch to "calendly" without touching the funnel.
NEXT_PUBLIC_CALENDAR_PLATFORM=ghl

# GHL calendar embed URLs (event type auto-selected by tier — lead never picks)
NEXT_PUBLIC_GHL_CALENDAR_EMBED_PRO=
NEXT_PUBLIC_GHL_CALENDAR_EMBED_ELITE=

# Calendly embed URLs (only used when CALENDAR_PLATFORM=calendly)
NEXT_PUBLIC_CALENDLY_EMBED_PRO=
NEXT_PUBLIC_CALENDLY_EMBED_ELITE=

# GoHighLevel CRM (server-only)
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_API_BASE_URL=https://services.leadconnectorhq.com

# Challenge self-serve checkout (Shopify / payment link — Pro & Elite never use this)
NEXT_PUBLIC_CHALLENGE_CHECKOUT_URL=https://theformulaperformance.com/products/the-formula-8-week-training-plan
NEXT_PUBLIC_CHALLENGE_CHECKOUT_EMBED_URL=
NEXT_PUBLIC_CHALLENGE_CHECKOUT_NEW_TAB=true

# Google Search Console + Analytics (optional)
GOOGLE_SITE_VERIFICATION=
GOOGLE_GTM_ID=
GOOGLE_GA4_ID=
GOOGLE_ADS_ID=

# YouTube Data API v3 (optional — validate video IDs)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Email signup popup (ghl | mailchimp | klaviyo | none)
EMAIL_PROVIDER=ghl
EMAIL_API_KEY=
EMAIL_LIST_ID=
MAILCHIMP_SERVER_PREFIX=

# Shopify (optional Storefront token)
SHOPIFY_STORE_DOMAIN=theformulaperformance.com
SHOPIFY_STOREFRONT_TOKEN=

# Reviews (internal CMS testimonials, or Judge.me)
REVIEWS_PROVIDER=internal
JUDGEME_API_TOKEN=
JUDGEME_SHOP_DOMAIN=

# Admin login for /admin/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-go-live
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Optional: machine/API bearer for scripts (in addition to session login)
# INTEGRATIONS_ADMIN_TOKEN=
