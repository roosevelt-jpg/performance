# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local deploy cache
.vercel
.cursor/

# typescript
*.tsbuildinfo
next-env.d.ts

# local integrations secrets (managed via /integrations UI)
/data/integrations.local.json
/data/cms.local.json
/data/apply-leads.json
/data/dna-reports/
/data/.write-probe
/data/.cms-write-probe
/data/test-*.json
